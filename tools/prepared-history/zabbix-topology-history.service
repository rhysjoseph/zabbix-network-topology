[Unit]
Description=Prepare older values for the Zabbix topology map
After=mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/zabbix-network-topology/history-v1
TimeoutStartSec=15min
EnvironmentFile=/etc/default/zabbix-topology-history
ExecStart=/usr/bin/php -d memory_limit=256M /usr/local/lib/zabbix-network-topology/history-worker.php prepare /usr/share/zabbix/modules/network_topology ${TOPOLOGY_HISTORY_GROUP_ID}
